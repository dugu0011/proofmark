# The browser sandbox image for Proofmark's `browser` tool.
# Build once:  proofmark build-sandbox
#
# Based on Playwright's official image, which carries Chromium and every system
# dependency it needs (installing those by hand on a slim image is fragile across
# Debian/Ubuntu releases). The base ships the browser binaries under
# /ms-playwright but not the Python package, so we add just the wheel — no
# browser download, since PLAYWRIGHT_BROWSERS_PATH already points at them.
FROM mcr.microsoft.com/playwright/python:v1.47.0-jammy

RUN pip install --no-cache-dir playwright==1.47.0

WORKDIR /work
CMD ["sleep", "infinity"]
